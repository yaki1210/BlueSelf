<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- 哨兵键：用于在运行时定位主题字典（不依赖 Source 路径） -->
    <s:String x:Key="__ThemeMarker">Light</s:String>

    <!-- 浅色主题 -->
    <SolidColorBrush x:Key="BrandBrush" Color="#4B3FE3" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#3B30CA" />
    <SolidColorBrush x:Key="BrandLightBrush" Color="#EEEDFC" />
    <SolidColorBrush x:Key="BrandTextBrush" Color="#1E1B4B" />

    <SolidColorBrush x:Key="WindowBgBrush" Color="#E8EBF0" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#F0F2F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="NavBgBrush" Color="#DFE3EB" />

    <SolidColorBrush x:Key="BorderBrush" Color="#B9C0CC" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D2D7E0" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0E1013" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3E4450" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#666D7C" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9098A5" />

    <SolidColorBrush x:Key="OnlineBrush" Color="#0EA971" />
    <SolidColorBrush x:Key="OnlineLightBrush" Color="#DDF7E9" />
    <SolidColorBrush x:Key="ConnectingBrush" Color="#E08E00" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#8C93A0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E2392B" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDE3E0" />

</ResourceDictionary>