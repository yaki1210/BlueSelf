<UserControl x:Class="FileTransferApp.WinUI.UI.Controls.AttachmentChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FileTransferApp.WinUI.UI">
    <UserControl.Resources>
        <converters:KindToGlyphConverter x:Key="KindToGlyph" />
    </UserControl.Resources>
    <Border Width="116" Height="64" CornerRadius="12" Background="#22F0F0F4"
            BorderBrush="#33000000" BorderThickness="1" Margin="0,0,8,0">
        <Grid Margin="0">
            <!-- 打底的图标 -->
            <TextBlock Text="{Binding Kind, Converter={StaticResource KindToGlyph}}"
                       FontFamily="Segoe MDL2 Assets" FontSize="40"
                       Foreground="#2A4B3FE3" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <!-- 文件信息 -->
            <StackPanel VerticalAlignment="Center" Margin="10,0,26,0">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           TextTrimming="CharacterEllipsis" MaxWidth="76" />
                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="Gray" Margin="0,1,0,0" />
            </StackPanel>
            <!-- 右上角 × 删除 -->
            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                    Width="20" Height="20" Background="Transparent" BorderThickness="0"
                    Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,3,3,0" Cursor="Hand"
                    ToolTip="移除附件"
                    Click="OnRemoveClick" />
        </Grid>
    </Border>
</UserControl>