<UserControl x:Class="FileTransferApp.WinUI.UI.Controls.AttachmentChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FileTransferApp.WinUI.UI">
    <UserControl.Resources>
        <converters:KindToGlyphConverter x:Key="KindToGlyph" />
        <converters:KindToBgBrushConverter x:Key="KindToBgBrush" />
        <converters:KindToFgBrushConverter x:Key="KindToFgBrush" />
    </UserControl.Resources>
    <Border Height="44" MinWidth="130" MaxWidth="175" CornerRadius="8"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Margin="0,0,8,0" Padding="6,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 文件类型图标徽标 -->
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                    Background="{Binding Kind, Converter={StaticResource KindToBgBrush}}"
                    Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Kind, Converter={StaticResource KindToGlyph}}"
                           FontFamily="{DynamicResource IconFont}" FontSize="14"
                           Foreground="{Binding Kind, Converter={StaticResource KindToFgBrush}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- 文件名与大小 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Text="{Binding SizeText}" FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0" />
            </StackPanel>

            <!-- 删除按钮 -->
            <Button Grid.Column="2" Content="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                    Width="20" Height="20" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                    Margin="4,0,0,0" Cursor="Hand" ToolTip="移除此附件"
                    Click="OnRemoveClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBd" Property="Background" Value="{DynamicResource DangerLightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>