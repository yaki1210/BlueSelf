<UserControl x:Class="FileTransferApp.WinUI.UI.Controls.TransferStatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Padding="16">
        <StackPanel>
            <!-- 头部状态指示 -->
            <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BrandLightBrush}" Margin="0,0,8,0">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource tpTitle}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{DynamicResource OnlineLightBrush}"
                        CornerRadius="10" Padding="8,2">
                    <TextBlock Text="传输中" FontSize="11" FontWeight="SemiBold" Foreground="#065F46" />
                </Border>
            </Grid>

            <!-- 当前传输文件小卡片 -->
            <Border Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                            Background="{DynamicResource BrandLightBrush}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="正在传输" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 传输进度条与百分比 -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="传输进度" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding PercentText}" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Right" />
            </Grid>
            
            <ProgressBar Style="{DynamicResource FluentProgressBar}"
                         Minimum="0" Maximum="100" Value="{Binding Progress}"
                         Height="7" Margin="0,0,0,14" />

            <Separator Margin="0,0,0,14" Background="{DynamicResource BorderSubtleBrush}" />

            <!-- 速率指标卡片 (2行卡片) -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource tpInstant}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding InstantRate}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xEC4A;" FontFamily="{DynamicResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource tpAvg}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding AvgMbps}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrandBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE957;" FontFamily="{DynamicResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>