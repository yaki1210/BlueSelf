<UserControl x:Class="FileTransferApp.WinUI.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="520" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="#171717" />

            <TextBlock Text="语言" FontSize="13" Foreground="#171717" FontWeight="SemiBold" Margin="0,22,0,6" />
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                      Width="200" HorizontalAlignment="Left" />

            <TextBlock Text="主题" FontSize="13" Foreground="#171717" FontWeight="SemiBold" Margin="0,20,0,6" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                      Width="200" HorizontalAlignment="Left" />

            <TextBlock Text="接收文件保存路径" FontSize="13" Foreground="#171717" FontWeight="SemiBold" Margin="0,20,0,6" />
            <Border Background="#EFEFF2" CornerRadius="8" Padding="12" Margin="0,0,0,0">
                <TextBlock Text="{Binding SavePath}" FontSize="13" Foreground="#52525B" TextWrapping="Wrap" />
            </Border>

            <TextBlock FontSize="12" Foreground="Gray" Margin="0,20,0,0"
                       TextWrapping="Wrap"
                       Text="此页面为界面预览（占位）。语言/主题/保存路径将在功能阶段二接入真实逻辑。" />

        </StackPanel>
    </ScrollViewer>
</UserControl>