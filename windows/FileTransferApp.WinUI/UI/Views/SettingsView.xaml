<UserControl x:Class="FileTransferApp.WinUI.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{DynamicResource stPref}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <!-- 通用与外观 -->
            <TextBlock Text="{DynamicResource stGeneral}" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,10" />
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,0,20">
                <StackPanel>
                    <!-- 语言设置行 -->
                    <Border Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,14,0">
                                <TextBlock Text="&#xF2B7;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource stLanguage}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       Margin="0,0,20,0" />
                            <ListBox Grid.Column="2" Style="{StaticResource SegmentedButton}"
                                      ItemContainerStyle="{StaticResource SegmentedButtonItem}"
                                      ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="16,0,16,0" />

                    <!-- 主题设置行 -->
                    <Border Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,14,0">
                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource stTheme}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       Margin="0,0,20,0" />
                            <ListBox Grid.Column="2" Style="{StaticResource SegmentedButton}"
                                      ItemContainerStyle="{StaticResource SegmentedButtonItem}"
                                      ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 传输与存储 -->
            <TextBlock Text="{DynamicResource stStorage}" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,0,20">
                <Border Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,14,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource stSavePath}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SavePath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ChangeSavePathCommand}"
                                Content="{DynamicResource stChange}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>