<UserControl x:Class="FileTransferApp.WinUI.UI.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileTransferApp.WinUI.UI.Controls"
             xmlns:converters="clr-namespace:FileTransferApp.WinUI.UI">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyTextToVisibilityConverter x:Key="EmptyToVis" />
    </UserControl.Resources>
    <Grid Margin="18,12,18,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左：设备栏 -->
        <Border Grid.Column="0" Background="#EFEFF2" CornerRadius="12" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6,4,0,8">
                    <TextBlock Text="本机" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LocalName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#171717" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Content="监听蓝牙" IsChecked="{Binding IsListening}" Margin="6,0,0,0" />

                <TextBlock Text="已配对设备" FontSize="12" Foreground="Gray" Margin="6,14,0,4" />
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                         Background="Transparent" BorderThickness="0" Margin="-6,0,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:DeviceListItem />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Style="{StaticResource PillButtonOutline}" Content="＋ 添加配对"
                        Command="{Binding AddPairingCommand}" Margin="6,10,6,0" Height="38" />
            </StackPanel>
        </Border>

        <!-- 中：编辑器 -->
        <Border Grid.Column="2" Background="#F7F7F8" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" FontSize="17" VerticalContentAlignment="Top"
                         BorderThickness="0" Background="Transparent" Padding="0,0,0,6"
                         Foreground="#171717" TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Text="输入文本……" FontSize="17" Foreground="#9AA0A6"
                           Margin="0,4,0,0" IsHitTestVisible="False"
                           Visibility="{Binding Text, Converter={StaticResource EmptyToVis}}" />

                <!-- 附件预览（横向） -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Attachments}" Margin="0,4,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><controls:AttachmentChip /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 按钮行 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource IconButton}" Content="&#xE77F;" Margin="0,0,6,0"
                            ToolTip="粘贴" Command="{Binding PasteCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B8;" Margin="0,0,6,0"
                            ToolTip="附件" Command="{Binding AttachCommand}" />
                    <Button Style="{StaticResource PillButton}" Content="发送    &#xE724;"
                            HorizontalAlignment="Right" Margin="0,0,0,0" Command="{Binding StartSendCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右：实时传输详情（默认隐藏，传输开始出现） -->
        <controls:TransferStatusPanel Grid.Column="4"
                                      Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>