<UserControl x:Class="FileTransferApp.WinUI.UI.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileTransferApp.WinUI.UI.Controls"
             xmlns:converters="clr-namespace:FileTransferApp.WinUI.UI">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EmptyTextToVisibilityConverter x:Key="EmptyToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:ConnectingToCollapsedConverter x:Key="ConnectingToCollapsed" />
        <converters:HasItemsToVisibilityConverter x:Key="HasItemsToVis" />
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 左侧：设备栏 -->
        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 列表标题 -->
                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <TextBlock Text="{DynamicResource wsPairedTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Command="{Binding RefreshDevicesCommand}"
                                Content="&#xE72C;" ToolTip="{DynamicResource wsRefresh}" Width="26" Height="26" FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- 设备列表：点击整行即（重）连接，状态由圆点颜色表达，无持久选中框 -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Devices}"
                         ItemContainerStyle="{StaticResource FluentListBoxItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 主体：单连接模型，整行点击：在线→设为目标；离线/失败→连接/重试；连接中→忽略。状态由圆点表达 -->
                                <Button Grid.Column="0" Style="{StaticResource RowButton}" Padding="0"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                        Command="{Binding DataContext.RowClickCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}">
                                    <controls:DeviceListItem />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部添加新设备按钮 -->
                <Button Grid.Row="2" Style="{StaticResource PillButtonOutline}"
                        Command="{Binding ShowAddDeviceCommand}" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource wsAddDevice}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 中间：编辑器核心卡片（方案 A：无目标行，目标信息由左侧设备栏表达；拖拽在窗口级处理） -->
        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="18" Margin="14,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 文本编辑区 + 占位水印（未选目标时水印转为引导文案） -->
                <Grid Grid.Row="0">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" FontSize="15" VerticalContentAlignment="Top" BorderThickness="0"
                             Background="Transparent" Padding="4" Foreground="{DynamicResource TextPrimaryBrush}"
                             TextWrapping="Wrap" CaretBrush="{DynamicResource BrandBrush}" />
                    <TextBlock Text="{Binding PlaceholderText}" FontSize="15"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               Margin="6,5,0,0" IsHitTestVisible="False"
                               Visibility="{Binding Text, Converter={StaticResource EmptyToVis}}" />
                </Grid>

                <!-- 附件裸排区（无容器：有附件才出现，chip 自带间距） -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="0,4,0,10"
                              Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><controls:AttachmentChip /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 待发内容总大小 + 底部操作按钮栏 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding PendingSizeText}" FontSize="11"
                               FontFamily="Consolas, Cascadia Code, monospace"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,0,6,8" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconCircleButton}" Command="{Binding PasteCommand}"
                                    ToolTip="粘贴剪贴板文本" Margin="0,0,8,0" Content="&#xE77F;" />
                            <Button Style="{StaticResource IconCircleButton}" Command="{Binding AttachCommand}"
                                    ToolTip="添加文件/图片/文档" Content="&#xE723;" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PillButton}" Command="{Binding StartSendCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource btnSend}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 右侧：实时传输详情（传输开始出现） -->
        <controls:TransferStatusPanel Grid.Column="2" Margin="14,0,0,0" Width="260"
                                      Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>