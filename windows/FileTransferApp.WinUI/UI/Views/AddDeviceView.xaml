<UserControl x:Class="FileTransferApp.WinUI.UI.Views.AddDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FileTransferApp.WinUI.UI">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:DeviceKindToGlyphConverter x:Key="KindToGlyph" />
        <converters:HasItemsToVisibilityConverter x:Key="HasItemsToVis" />
    </UserControl.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：返回 + 标题 + 刷新 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource IconCircleButton}"
                    Content="&#xE72B;" Command="{Binding ShowWorkspaceCommand}"
                    ToolTip="{DynamicResource adBack}" VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Text="{DynamicResource adTitle}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />

            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                    Command="{Binding StartScanCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource wsRefresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 扫描状态横幅 -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14,12" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SurfaceAltBrush}">
                    <TextBlock Text="{Binding IsScanning, Converter={StaticResource BoolToVis}}" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
                    <!-- 正在扫描 -->
                    <TextBlock Text="{DynamicResource adScanning}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 扫描完成 -->
                    <TextBlock Text="{DynamicResource adScanDone}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 扫描中的不确定进度 -->
                <ProgressBar Grid.Column="2" Width="80" Height="4" IsIndeterminate="True"
                             Background="Transparent" Foreground="{DynamicResource BrandBrush}"
                             VerticalAlignment="Center">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <!-- 设备列表 -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ScannedDevices, Converter={StaticResource HasItemsToVis}}">
                <ItemsControl ItemsSource="{Binding ScannedDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 类型图标 -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <TextBlock Text="{Binding Kind, Converter={StaticResource KindToGlyph}}"
                                                   FontFamily="{StaticResource IconFont}" FontSize="17"
                                                   Foreground="{DynamicResource BrandBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 名称 + 已配对/地址 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- 已配对徽标 -->
                                            <Border Background="{DynamicResource OnlineLightBrush}" CornerRadius="4"
                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaired}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{DynamicResource adPaired}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource OnlineBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AddressText}" FontSize="10" FontFamily="Consolas, Cascadia Code, monospace"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- 连接并添加 -->
                                    <Button Grid.Column="2" Style="{StaticResource PillButton}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ConnectAndAddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{DynamicResource adConnectAdd}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态（仅当非扫描且无设备时显示） -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ScannedDevices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE794;" FontFamily="{StaticResource IconFont}" FontSize="44"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource adEmpty}" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>