<Window x:Class="FileTransferApp.WinUI.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FileTransferApp.WinUI.UI.Views"
        xmlns:converters="clr-namespace:FileTransferApp.WinUI.UI"
        Title="BlueSelf" Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="Bean" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：设置 · BlueSelf · 收件箱 -->
        <Border Grid.Row="0" Background="#F7F7F8" BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                        HorizontalAlignment="Left" ToolTip="设置" Command="{Binding ShowSettingsCommand}" />
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Center" Command="{Binding ShowWorkspaceCommand}"
                        ToolTip="返回工作区">
                    <TextBlock Text="BlueSelf" FontSize="20" FontWeight="Bold" Foreground="#4B3FE3" />
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE715;"
                        HorizontalAlignment="Right" ToolTip="收件箱" Command="{Binding ShowInboxCommand}" />
            </Grid>
        </Border>

        <!-- 内容区：按当前视图切换 -->
        <Grid Grid.Row="1">
            <views:WorkspaceView Visibility="{Binding IsWorkspace, Converter={StaticResource Bean}}" />
            <views:InboxView Visibility="{Binding IsInbox, Converter={StaticResource Bean}}" />
            <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource Bean}}" />
        </Grid>

        <!-- 底部：日志（默认折叠） -->
        <Expander Grid.Row="2" IsExpanded="False" Margin="12,6,12,12" Header=" 日志"
                  Foreground="#52525B" FontSize="12">
            <Border Background="#F0F0F2" CornerRadius="8" MaxHeight="160">
                <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Time}" Foreground="Gray" FontFamily="Consolas" />
                                <TextBlock Text="  " />
                                <TextBlock Text="{Binding Message}" Foreground="#171717" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>
    </Grid>
</Window>